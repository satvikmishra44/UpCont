NODE_ENV=development
LOG_LEVEL=info
MOCK_MODE=true

VIDEO_UPLOAD_ROOT=C:\replace\with\approved\video\folder
MAX_VIDEO_SIZE_MB=500

YOUTUBE_MODE=mock
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:53682/oauth2/callback
YOUTUBE_TOKEN_PATH=.data/youtube-token.json

FACEBOOK_MODE=mock
INSTAGRAM_MODE=mock

META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=

META_REDIRECT_URI=http://127.0.0.1:53683/meta/oauth/callback
META_GRAPH_VERSION=v26.0
META_TOKEN_PATH=.data/meta-token.json

META_INSTAGRAM_POLL_INTERVAL_MS=5000
META_INSTAGRAM_PROCESSING_TIMEOUT_MS=300000